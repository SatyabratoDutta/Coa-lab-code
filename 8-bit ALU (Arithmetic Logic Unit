module ALU (
    input [7:0] A, B,
    input [2:0] SEL,
    output reg [7:0] Y,
    output reg Carry
);

always @(*) begin
    Carry = 0;

    case (SEL)

        3'b000: {Carry, Y} = A + B;
        3'b001: Y = A - B;
        3'b010: Y = A & B;
        3'b011: Y = A | B;
        3'b100: Y = A ^ B;
        3'b101: Y = ~A;
        3'b110: Y = A << 1;
        3'b111: Y = A >> 1;

        default: Y = 8'b00000000;

    endcase
end

endmodule
