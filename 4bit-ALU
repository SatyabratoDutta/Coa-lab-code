
module ALU(
    input [3:0] A, B,
    input [2:0] sel,
    output reg [7:0] Y
);

always @(*) begin
    case(sel)
        3'b000: Y = A + B;
        3'b001: Y = A - B;
        3'b010: Y = A * B;
        3'b011: Y = A & B;
        3'b100: Y = A | B;
        3'b101: Y = A ^ B;
        3'b110: Y = ~A;
        3'b111: Y = A << 1;
        default: Y = 0;
    endcase
end
endmodule
